# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here

# OpenAI (GPT-4o Vision)
OPENAI_API_KEY=sk-proj-your_openai_key_here

# Replicate (Object Detection with GroundingDINO)
# Get API token from: https://replicate.com/account/api-tokens
# Used to detect individual items and get bounding boxes for cropping
REPLICATE_API_TOKEN=r8_your_token_here

# Remove.bg (Background Removal for Individual Items)
# Get API key from: https://www.remove.bg/api
# Set to 'true' to enable, 'false' to use original images without segmentation
USE_BACKGROUND_REMOVAL=false
REMOVEBG_API_KEY=

# Anthropic (Claude AI) - DEPRECATED, now using OpenAI
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
